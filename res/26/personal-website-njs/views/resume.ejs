<%- include(viewsDir + 'partials/header.ejs') %>
<%- include(viewsDir + 'partials/nav.ejs') %>

        <section id="Summary">

            <div class="container p-4 pt-50">
                <div class="mt-5 p-5 text-center bg-primary bg-opacity-25 rounded-3">
                    <h1 id="currRole" class="text-body-emphasis"><%= dataSumm['currRole'] %></h1>
                    <p class="lead">
                        <%= dataSumm['currDesc'] %>
                    </p>
                </div>
            </div>

        </section>

        <section id="History">

            <div class="container px-4 pt-4">
                <h2 class="pb-2 border-bottom">History<button class="btn" data-bs-toggle="collapse" data-bs-target="#sec-history">Collapse/Expand</button></h2></h2>
                <div class="list-group py-4 px-2 collapse show" id="sec-history">
                    <% dataHist.forEach((item) => { %>
                        <a class="list-group-item d-flex gap-3 py-3 <% if (item["end"] === "now") { %> bg-primary bg-opacity-25 <% } else { %> bg-secondary bg-opacity-25 <% } %>"
                            aria-current="true"> <img src=<%= item["logo"] %> alt=<%= item["company"] %> height="50" flex-shrink-0>
                            <div class="d-flex gap-2 w-100 justify-content-between">
                                <div>
                                    <h4 class="mb-0 <% if (item["end"] === "now") { %> opacity-100 <% } else { %> opacity-75 <% } %>"><%= item["company"] %></h4>
                                    <p class="mb-0 <% if (item["end"] === "now") { %> opacity-75 <% } else { %> opacity-50 <% } %>"><%= item["role"] %></p>
                                </div>
                                <small class="<% if (item["end"] === "now") { %> opacity-100 <% } else { %> opacity-75 <% } %>text-nowrap"><%= item["start"] %> - <%= item["end"] %></small>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </div>

        </section>

        <section id="Qualifications">

            <div class="container px-4 pt-4">
                <h2 class="pb-2 border-bottom">Qualifications<button class="btn" data-bs-toggle="collapse" data-bs-target="#sec-quals">Collapse/Expand</button></h2>
                <div class="card px-2 mt-4 rounded-3 bg-secondary bg-opacity-25 collapse show" id="sec-quals">
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 py-4">
                        <% dataQual.forEach((item) => { %>
                            <div class="col d-flex align-items-start qual-item">
                                <img src=<%= item['badge'] %> alt=<%= item['qualification'] %> class="bi text-body-secondary flex-shrink-0 me-3"
                                    width="50" aria-hidden="true">
                                <div>
                                    <h3 class="fw-bold mb-0 fs-4 text-body-emphasis"><%= item['qualification'] %></h3>
                                    <p><%= item['byline'] %></p>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

        </section>

        <section id="TechSkills">

            <div class="container px-4 pt-4">
                <h2 class="pb-2 border-bottom">Technical Skills<button class="btn" data-bs-toggle="collapse" data-bs-target="#sec-tech">Collapse/Expand</button></h2>
                <div class="collapse show" id="sec-tech">

                    <% Object.keys(dataTech).forEach((key) => { %>

                        <div class="container mt-4 px-2 py-50">
                            <div class="p-4 text-center rounded-3 bg-secondary bg-opacity-25">
                                <div>
                                    <h4 class="text-body-emphasis"><%= key %></h4>
                                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 pt-5">

                                        <% dataTech[key].forEach((item) => { %>

                                            <div class="col d-flex align-items-start skills">
                                                <img src=<%= item['badge'] %> alt=<%= item['tech'] %> class="bi text-body-secondary flex-shrink-0 me-3"
                                                    width="50" aria-hidden="true">
                                                <div>
                                                    <h3 class="fw-light mb-0 fs-4 text-body-emphasis"><%= item['tech'] %></h3>
                                                </div>
                                            </div>

                                        <% }) %>

                                    </div>
                                </div>
                            </div>
                        </div>

                    <% }) %>

                </div>
            </div>

        </section>

        <section id="DomainSkills">

            <div class="container px-4 pt-5">
                <h2 class="pb-2 border-bottom">Domain and Functional Skills<button class="btn" data-bs-toggle="collapse" data-bs-target="#sec-domn">Collapse/Expand</button></h2>
                <div class="container px-2 collapse show" id="sec-domn">
                    <div class="row row-cols-2 row-cols-lg-4 align-items-stretch g-4 py-4">
                        <% dataDomn.forEach((item) => { %>
                            <div class="col">
                                <div class="card card-cover h-100 overflow-hidden rounded-3 position-relative">
                                    <div class="card-bg" style="background-image: url('../assets/stock/markus-spiske-hvSr_CVecVI-unsplash.jpg');"></div>
                                    <div class="d-flex flex-column h-100 p-2 position-relative">
                                        <h3 class="p-4 display-9 lh-1 text-white fw-light"><%= item['skill'] %></h3>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        
        </section>

        <section id="Assignments">

            <div class="container px-4 pt-5">
                <h2 class="pb-2 border-bottom">Recent Assignments<button class="btn" data-bs-toggle="collapse" data-bs-target="#sec-assgn">Collapse/Expand</button></h2>
                    <div class="collapse show" id="sec-assgn">

                    <% dataAssn.forEach((item) => { %>

                        <% if (item.inactive !== true) { %>
                    
                            <div class="container mt-4 px-2 py-50">
                                <div class="p-4 text-center rounded-3 bg-primary bg-opacity-25">
                                    <div>
                                        <h2 class="text-body-emphasis"><%= item['client'] %></h2>
                                        <h3 class="text-body-secondary"><%= item['role'] %></h3>
                                        <h6 class="text-body-tertiary"><%= item['start'] %> - <%= item['end'] %></h6>
                                        <div class="py-4 badge-grid">
                                            <% item['domain-tags'].forEach((domain) => { %>
                                                <span
                                                    class="badge d-flex align-items-center py-1.5 px-3 text-secondary-emphasis bg-secondary bg-opacity-50 border border-secondary-subtle rounded-pill">
                                                    <%= domain %>
                                                </span>
                                            <% }) %>
                                        </div>
                                        <% item['summary'].forEach((para) => { %>                                        
                                            <p class="lead">
                                                <%= para %>
                                            </p>
                                        <% }) %>
                                    </div>
                                    <div class="py-4 badge-grid">
                                        <% item['tech-tags'].forEach((tech) => { %>
                                            <span
                                                class="badge d-flex align-items-center pt-1 pe-2 text-<%= tech['style'] %>-emphasis bg-<%= tech['style'] %>-subtle border border-<%= tech['style'] %>-subtle rounded-pill">
                                                <img class="mx-1" height="24" src=<%= tech['badge'] %> alt=<%= tech['tech'] %>><%= tech['tech'] %>
                                            </span>
                                        <% }) %>
                                    </div>
                                    <div class="container px-1 assignment-cards">
                                        <div class="row row-cols-1 row-cols-lg-3 align-items-stretch g-4">
                                            <% item['highlights'].forEach((highlight) => { %>
                                                <div class="col">
                                                    <div class="card card-cover h-100 overflow-hidden text-bg-dark bg-opacity-50 rounded-4">
                                                        <div class="d-flex flex-column h-100 p-3 text-white text-shadow-1">
                                                            <p class="pt-1 mt-1 mb-1 display-10 lh-1 ">
                                                                <%= highlight %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        <% } %>
                
                    <% }) %>

                </div>
            </div>

        </section>

    </body>
    
<%- include(viewsDir + 'partials/footer.ejs') %>