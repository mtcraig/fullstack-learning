<%- include(viewsDir + 'partials/header.ejs') %>
<%- include(viewsDir + 'partials/nav.ejs') %>

        <section id="Portfolio">

            <section class="pt-5 text-center container">
                <div class="row py-lg-8">
                    <div class="col-lg-10 col-md-8 mx-auto">
                        <h1 class="fw-light"><%= portSumm.title %></h1>
                        <p class="lead text-body-secondary"><%= portSumm.description %></p>
    
                    </div>
                </div>
            </section>
            <div class="album py-5">
                <div class="container">
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                        <% portProj.forEach((project) => { %>
                            <div class="col">
                                <div class="card shadow-sm">
                                    <svg aria-label="Placeholder: Thumbnail"
                                        class="bd-placeholder-img card-img-top" height="225" preserveAspectRatio="xMidYMid slice"
                                        role="img" width="100%"
                                        xmlns="http://www.w3.org/2000/svg">
                                        <rect width="100%" height="100%" fill="#55595c"></rect><text x="50%" y="50%" fill="#eceeef"
                                            dy=".3em">Thumbnail</text>
                                    </svg>
                                    <div class="card-body">
                                        <h3><%= project.title %></h3>
                                        <p class="card-text"><%= project.description %></p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-sm btn-outline-secondary">View</button>
                                            </div>
                                            <small class="text-body-secondary"><%= project.date %></small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

        </section>
        
    </body>

<%- include(viewsDir + 'partials/footer.ejs') %>